---
import '../styles/global.css';
import Dashboard from '../components/react/Dashboard'
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>V05 — Employer & Placement Drive Records</title>
</head>
<body>
  <div class="shell flex min-h-screen flex-col">
    <!-- Left Navigation Rail -->
    <div class="rail hidden md:flex md:w-[230px] shrink-0 bg-[#5E1129] text-[#F4E3E9] flex-col py-5 sticky top-0 md:h-screen md:border-r border-white/10">
      <div class="rail-brand px-5 pb-5 mb-4">
        <div class="mark font-['Poppins'] font-bold text-[19px] text-white">Placement Cell</div>
        <div class="sub text-[11px] uppercase tracking-[1.4px] text-[#D79CAE] mt-1">V05 · Employer Records</div>
      </div>
      <div class="px-5 text-sm text-[#F4E3E9] opacity-90 leading-6">
        A compact employer and placement tracking tool for campus recruitment.
      </div>
    </div>

    <!-- Main Content Area populated by React Island -->
    <main class="main flex-1 w-full bg-[#FBF7F8] py-4 md:py-6 overflow-x-hidden">
      <div class="mx-auto w-full max-w-full px-4 sm:px-5 md:px-8">
        <div class="mobile-brand block md:hidden mb-4 rounded-[26px] bg-[#5E1129] p-4 text-white shadow-sm">
          <div class="font-['Poppins'] font-bold text-[18px]">Placement Cell</div>
          <div class="uppercase tracking-[1.4px] text-[10px] text-[#D79CAE] mt-1">V05 · Employer Records</div>
          <div class="mt-3 text-[13px] leading-5 text-[#F4E3E9]">Track placement records for campus recruitment on the go.</div>
        </div>
        <Dashboard client:load />
      </div>
    </main>
  </div>
</body>
</html>
